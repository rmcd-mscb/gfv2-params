#!/bin/bash
#SBATCH -p cpu
#SBATCH -A impd
#SBATCH --job-name=dprst_depth_plan
#SBATCH --output=logs/job_%j.out
#SBATCH --error=logs/job_%j.err
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#
# Stage 1 of the dprst_depth pipeline (issue #173 Task 9; real tile-inventory
# planning, issue #223 part 2): reconstructs + tags the CONUS dprst polygon
# set (best_topo + ranked tile-set candidates via sources.tag_and_assign
# against the staged 3DEP inventory, ecoregion via EPA L3 -- same
# reconstruction depstor_builders/dprst_depth.py's builder uses), groups
# polygons by their assigned PRIMARY tile set (tiling.tile_set_groups), and
# bins those groups into N_TILE_BATCHES SLURM-array batches (tiling.tile_batches
# -- greedy LPT bin-packing by estimated DEM-window-read COST (~100x weight for
# 1m vs 10m polygons; see tiling.polygon_window_cost / MAX_1M_WINDOW_CELLS),
# not raw polygon count). Each polygon belongs to exactly one tile set, so
# no cross-polygon component-chaining is needed (the old hull-driven
# transitive tile-key chaining is gone -- it produced components spanning
# >4,000 tiles and let two array tasks inherit ~16,000/~12,000 fallback
# polygons each and run past 24 h against a 34-minute median, #223 part 2).
# Persists both to {output_dir}/dprst_depth_batches/_plan/ for
# run_dprst_depth_batch.batch's array tasks to read. Pure geometry + local
# vector/parquet reads -- NO live S3/vsicurl: tile existence and extent are
# already resolved in the staged 3DEP inventory (input/3dep/dem_1m_tile_
# inventory.parquet, staged by stage_dem_1m_inventory.batch), so
# sources.tag_and_assign never probes a raster here. --mem=32G covers the
# full CONUS waterbody/tile-inventory/ecoregions vector+parquet loads
# comfortably (these are vector GeoDataFrames / tables, not raster grids --
# contrast the 384G full-grid depstor builders).
#
# Submitted first by slurm_batch/submit_dprst_depth.sh; the array job
# (stage 2) depends afterok on this one.
#
# Standalone:
#   sbatch --export=ALL,BASE_CONFIG=configs/base_config.yml,FABRIC=gfv2,N_TILE_BATCHES=150 \
#       slurm_batch/plan_dprst_depth_batches.batch
# Dry-run/sizing check without submitting anything (prints the same summary,
# still writes the plan artifacts -- run on the head node only if the fabric
# is small, e.g. oregon; CONUS-scale should go through sbatch):
#   pixi run python -m gfv2_params.dprst_depth.tiling --plan --fabric oregon --n-batches 20
# See slurm_batch/RUNME.md and slurm_batch/HPC_REFERENCE.md for detail.

cd "$SLURM_SUBMIT_DIR" || exit 1
BASE_CONFIG=${BASE_CONFIG:-configs/base_config.yml}
FABRIC=${FABRIC:-gfv2}
N_TILE_BATCHES=${N_TILE_BATCHES:-150}

pixi run --as-is python -m gfv2_params.dprst_depth.tiling \
    --plan \
    --config configs/depstor/depstor_rasters.yml \
    --base_config "$BASE_CONFIG" \
    --fabric "$FABRIC" \
    --n-batches "$N_TILE_BATCHES"
