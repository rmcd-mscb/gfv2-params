#!/bin/bash
#SBATCH -p cpu
#SBATCH -A impd
#SBATCH --job-name=dprst_depth_batch
#SBATCH --output=logs/job_%A_%a.out
#SBATCH --error=logs/job_%A_%a.err
#SBATCH --time=12:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#
# Stage 2 of the dprst_depth pipeline (issue #173 Task 9; tile-set batching +
# threading, issue #223 part 2): ONE array task computes dprst_depth for ONE
# batch of real 3DEP tile SETS (Task 3's work-list; fan-out unit is the tile
# SET, not a raw elevation tile and not the polygon -- see
# submit_dprst_depth.sh's header for the full <=5 hr sizing arithmetic).
# Reads the plan step's persisted tagged polygon set + batch manifest
# (scripts/run_dprst_depth_batch.py) -- no S3/WESM/waterbody re-derivation
# per task -- opens each of this batch's tile sets ONCE, and writes one
# per-batch parquet (Task 4's compute.run_batch), running --cpus-per-task
# sets CONCURRENTLY on threads (the work is remote-read bound, not CPU
# bound -- on the OLD pre-#223-part-2 per-polygon path, which 51.6% of
# gfv2r2 polygons took, 73% of the FALLBACK time, not overall pipeline
# time, was vrt.read -- see compute.py's module docstring for that
# slow-path regression this fixes). --cpus-per-task=8 (was 2): `guard_oversized_windows` caps any
# single 1 m window at 200M cells, budgeted in tiling.py at ~4 GiB/window
# (20 bytes/cell); 8 concurrent windows at that cap is ~32-38 GB, and this
# task's own second full-footprint boolean rasterization
# (`interior_coverage`) roughly doubles the mask memory per window on top
# of that. --mem=96G (was 64G) is a BOUND against that worst case, not a
# measurement of one -- `tile_batches` balances each batch's TOTAL
# estimated cost, not peak concurrency, so nothing guarantees a batch's 8
# largest windows don't land on 8 different sets that all get scheduled at
# once; nearly all real windows are orders of magnitude below the cap, but
# a semaphore keyed on window cost (to bound peak concurrency tightly) is a
# change deliberately left for a later PR, not this one -- this repo's
# standing guidance for a CONUS-scale memory question is to bump --mem
# rather than add a tuning knob. every task still holds the FULL CONUS
# dprst polygon set in memory (a vector GeoDataFrame, not CONUS-grid-scale;
# contrast the 384G full-grid depstor builders) on top of the window
# budget above. --time=12:00:00 (the pothole-belt mega-component batch
# runs >4h; a few long-pole batches need the headroom — the guard fixed
# OOM but not the intrinsic long-pole) leaves margin under the 5 hr target
# even at 2x the per-batch estimate.
#
# Submitted by slurm_batch/submit_dprst_depth.sh (afterok the plan job,
# stage 1). Array size ($N_TILE_BATCHES) MUST match the plan step's
# --n-batches -- submit_dprst_depth.sh always uses the same value for both.
#
# Standalone (after the plan step has already run):
#   N=$(python -c "import json; print(json.load(open('<output_dir>/dprst_depth_batches/_plan/batch_manifest.json'))['n_batches'])")
#   sbatch --array=0-$((N-1)) \
#       --export=ALL,BASE_CONFIG=configs/base_config.yml,FABRIC=gfv2 \
#       slurm_batch/run_dprst_depth_batch.batch
# See slurm_batch/RUNME.md and slurm_batch/HPC_REFERENCE.md for detail +
# recovery (a failed/timed-out array task can be resubmitted individually --
# it only (re)writes its own batch_XXXX.parquet).
#
# --threads is passed explicitly below (issue #223 review round 2, finding 6):
# scripts/run_dprst_depth_batch.py's own --threads default reads
# $SLURM_CPUS_PER_TASK, and this batch is the repo's ONLY use of that variable, so
# nothing here actually proved it is exported into the task's environment. If it
# were ever absent, every 8-way task would silently run its tile sets SERIALLY --
# exactly the regression this branch's threading fix (compute.py's module
# docstring) exists to remove -- with no error, just a slower run. Pass it
# explicitly with the same fallback (8, matching --cpus-per-task above) so the
# concurrency is never silently unproven.

cd "$SLURM_SUBMIT_DIR" || exit 1
BASE_CONFIG=${BASE_CONFIG:-configs/base_config.yml}
FABRIC=${FABRIC:-gfv2}

pixi run --as-is python scripts/run_dprst_depth_batch.py \
    --config configs/depstor/depstor_rasters.yml \
    --base_config "$BASE_CONFIG" \
    --fabric "$FABRIC" \
    --batch_id "$SLURM_ARRAY_TASK_ID" \
    --threads "${SLURM_CPUS_PER_TASK:-8}"
